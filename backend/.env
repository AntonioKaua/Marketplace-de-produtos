# Porta em que o servidor Express vai rodar.
PORT=3000

# URL do seu projeto Supabase (Project Settings > API > Project URL).
# Usada em src/config/supabase.ts.
SUPABASE_URL=https://zbarhckesochxsnvqdpd.supabase.co

# Chave publicável do Supabase (Project Settings > API Keys).
# NÃO é usada em nenhum lugar deste backend — ela serve para o Supabase Auth
# nativo, que este projeto não usa (a autenticação aqui é própria, com JWT +
# bcrypt, em src/services/token.service.ts). Fica documentada só porque é
# uma das variáveis que o próprio Supabase sugere ao criar o projeto.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Q3m4uylj4WE50DPBUSVzaA_-koA68vb

# Chave secreta do Supabase (service role — Project Settings > API Keys).
# Usada em src/config/supabase.ts para TODAS as consultas ao banco.
# Nunca deve ser exposta ao frontend nem commitada.
SUPABASE_SECRET_KEY=sb_secret_ZAtztLisdCEIBtzsnZTj0A_IPSOi_05

# URL do JWKS do Supabase Auth (Project Settings > API).
# Assim como a publishable key, NÃO é usada no código — serve para validar
# tokens emitidos pelo Supabase Auth, que este projeto não usa.
SUPABASE_JWKS_URL=https://zbarhckesochxsnvqdpd.supabase.co/auth/v1/.well-known/jwks.json

# Chave usada para assinar/verificar o token de sessão dos usuários
# (src/services/token.service.ts). Precisa ter pelo menos 32 caracteres.
# Gere uma aleatória, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=1630070cde78d2b140700cbdca6070f69b965779f95f8f437e2e54032ad531f5npm

# URL pública do frontend. Usada em src/config/mercadopago.ts para montar os
# back_urls do Mercado Pago (para onde o comprador é redirecionado depois de
# pagar: /checkout/success, /checkout/failure, /checkout/pending).
FRONTEND_URL=http://localhost:5173

# URL pública deste backend. Usada em src/config/mercadopago.ts como
# notification_url do Mercado Pago (para onde ele envia o webhook de
# pagamento em src/controllers/payment.controller.ts).
# Em dev local o Mercado Pago não alcança "localhost" — use um túnel
# (ex: ngrok http 3000) e coloque a URL pública aqui para testar o
# fluxo de pagamento ponta a ponta.
BACKEND_URL=http://localhost:3000

# Access token da sua aplicação Mercado Pago (TEST- para sandbox, APP_USR-
# para produção). Crie em https://www.mercadopago.com.br/developers/panel/app
# Usada em src/config/mercadopago.ts. Sem ela, tudo funciona normalmente —
# só a criação de pedido/checkout falha.
MP_ACCESS_TOKEN=APP_USR-5879186494080375-090112-5cf0e9bcf7f231076f9b9b87e74189b6-3642401431

# Opcional: chave secreta de webhook (painel do Mercado Pago > Notificações),
# usada em src/controllers/payment.controller.ts para validar a assinatura
# (x-signature) das notificações recebidas. Se deixar em branco, a
# validação de assinatura é simplesmente pulada (sem quebrar nada).
MP_WEBHOOK_SECRET=
